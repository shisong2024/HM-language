+-- | Type of a bare expression, without discharging its implicit wants.
+--
+--   This is what the REPL's @:t@ needs: @:t someConstrainedFn@ has to print
+--   @Forall a. {MyOrd a} => a -> Int@, not "No implicit value of type MyOrd a
+--   is available".  programChecker cannot be reused for that because it
+--   resolves every Wanted eagerly -- it has to produce a runnable expression.
+typeOfExpr :: Checker m => TEnv -> IEnv -> E' -> m S'
+typeOfExpr env ienv e = do
+    r <- inferExpr env ienv e
+    fst <$> closeBinding env (irType r) (irWanted r) (irExpr r)
